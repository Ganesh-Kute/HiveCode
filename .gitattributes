# Merge code files with ICR (intent-aware merge) — our own icr-merge package.
# Dogfood: this repo merges itself with the tool it ships. Anyone without the
# driver configured falls back to git's default merge (safe). To enable:
#   npx icr-merge-install
*.js  merge=icr
*.mjs merge=icr
*.cjs merge=icr

# Generated files are compared byte-for-byte by their parity tests, so their line endings must
# not depend on the checkout (core.autocrlf rewrote them to CRLF on a fresh Windows clone).
extension/hive-privacy.cjs text eol=lf
