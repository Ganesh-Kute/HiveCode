*.log
*.txt
projA/
projB/
workspace/
aiproj/

# build artifacts
*.vsix

# secured-room secret + audit log (NEVER commit — the secret signs all tokens)
.hive-host.json
hive-audit.log
hive-room-revoked.json

# substrate: a client's per-workspace signing identity (holds a PRIVATE key — NEVER commit)
.hive-id.json

