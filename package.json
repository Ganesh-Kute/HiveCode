{
  "name": "hivecode-mcp",
  "version": "0.11.4",
  "description": "MCP server that lets any AI coding agent join a Hivecode room \u2014 humans and multiple AI agents edit one live codebase with folder-scoped permissions and approval gates.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Ganesh-Kute/HiveCode",
  "bugs": {
    "url": "https://github.com/Ganesh-Kute/HiveCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganesh-Kute/HiveCode.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "claude",
    "collaboration",
    "realtime",
    "yjs"
  ],
  "bin": {
    "hivecode-mcp": "hive-mcp.js"
  },
  "files": [
    "hive-mcp.js",
    "hive-mailbox.js",
    "sync.js",
    "core.js",
    "limits.js",
    "grm-link.cjs",
    "token.js",
    "icr.js",
    "lang-js.js",
    "lang-brace.js",
    "lang-python.js",
    "lang-ruby.js",
    "lang-json.js",
    "lang-yaml.js",
    "lang-toml.js",
    "icr-merge.js",
    "hive-coord.js",
    "substrate.js",
    "HIVE_RULES.md",
    "docs/MCP.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs || exit 0",
    "start": "node server.js",
    "relay": "node server.js",
    "sync:engine": "node sync-engine.mjs",
    "check:engine": "node sync-engine.mjs --check",
    "pretest": "node scripts/sync-engine.mjs --check && node scripts/check-files.mjs",
    "test": "node tests/test.js",
    "test:identity": "node tests/identity-audit-test.mjs",
    "test:billing": "node tests/billing-test.mjs",
    "test:license": "node tests/hive-license-test.js",
    "test:money": "node tests/payment-e2e-test.mjs && node tests/subscribe-test.mjs && node tests/lifecycle-test.mjs && node tests/billing-test.mjs && node tests/hive-license-test.js && node tests/recover-test.mjs",
    "check:web": "tsc --noEmit",
    "build:web": "esbuild web/src/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/app.js",
    "test:substrate": "node substrate-test.js",
    "test:substrate:live": "node substrate-live-test.js",
    "test:substrate:enforce": "node substrate-enforce-test.js",
    "test:substrate:authority": "node substrate-authority-test.js",
    "test:substrate:all": "node substrate-test.js && node substrate-live-test.js && node substrate-enforce-test.js && node substrate-authority-test.js",
    "test:recover": "node tests/recover-test.mjs",
    "test:mailbox": "node tests/mailbox-test.mjs && node tests/mcp-wait-test.mjs",
    "test:limits": "node tests/limits-test.mjs",
    "test:rejoin": "node tests/rejoin-clobber-test.mjs",
    "test:prod": "node tests/test.js && node tests/firstrun-test.mjs && node tests/credential-split-test.mjs && node tests/limits-test.mjs && node tests/usage-meter-test.mjs && node tests/rejoin-clobber-test.mjs && node tests/durability-test.mjs && node tests/payment-e2e-test.mjs && node tests/subscribe-test.mjs && node tests/lifecycle-test.mjs && node tests/billing-test.mjs && node tests/hive-license-test.js && node tests/recover-test.mjs && node demo/wrap-test.mjs",
    "test:meter": "node tests/usage-meter-test.mjs",
    "test:subscribe": "node tests/subscribe-test.mjs",
    "test:cred": "node tests/credential-split-test.mjs",
    "test:firstrun": "node tests/firstrun-test.mjs",
    "test:lifecycle": "node tests/lifecycle-test.mjs",
    "test:payment": "node tests/payment-e2e-test.mjs",
    "scorecard": "node scorecard.mjs",
    "demo:video": "node demo/record.mjs",
    "test:wrap": "node demo/wrap-test.mjs",
    "demo:panel": "node demo/record-panel.mjs",
    "demo:all": "node demo/record.mjs && node demo/record-panel.mjs",
    "check:files": "node scripts/check-files.mjs",
    "prepublishOnly": "node scripts/check-files.mjs",
    "demo:cast": "node demo/cast.mjs --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "acorn": "^8.17.0",
    "ignore": "^7.0.5",
    "ws": "^8.18.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "main": "core.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "Ganesh Shivlal Kute <support@getgrm.tech>"
}
