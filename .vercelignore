# Vercel needs public/ (the site), api/ (the serverless functions), and
# vercel.json + package.json. Everything else is repo, not deploy.
#
# Keep this tight: the CLI uploads every non-ignored file from your machine, so one stray
# 45 MB asset or a 17 MB scratch directory is the difference between a deploy that works
# on a normal connection and one that dies at 100%.

.git
.vscode
node_modules
extension
packages

# tooling + scratch state
.claude
.github
.vercel
.vexp
.tasktmp
.hive-relay-data

# The demo toolchain and every master recording it has ever produced. Measured at 983 MB --
# `*.mjs` kept the scripts out but nothing kept out the .mp4/.png they write, and a deploy that
# tries to push a gigabyte either dies at 100% or publishes every raw master at a guessable URL.
# The site serves its own re-encodes from public/; nothing here is ever fetched by a browser.
demo

# source and docs that never reach a browser
docs
tests
web
marketing
data
brand
enterprise-test
real-test-scenario
hive-work-resolve
demo-recording*
*.md

# build artefacts and non-web files
*.vsix
*.wasm
*.mjs
*.txt
*.cpp
*.java
*.json
*.html

# the uncompressed master recording (45 MB); the site serves the 17 MB
# hivecode-icr-demo.mp4 re-encode instead
public/Hivecode___ICR.mp4

!package.json
!vercel.json

# EVERY PAGE THE SITE LINKS TO MUST BE RE-INCLUDED HERE. The `*.html` rule above is a
# blanket exclude, so a page that is not listed below is simply absent from the deploy and
# answers 404 -- silently, because nothing checks. The homepage footer linked to /contact,
# /privacy, /terms, /refunds, /docs, /license and /start, and every one of those was a 404
# in production; so was /recover, the page someone reaches precisely when they have lost
# their licence key. Adding a page to public/ is not enough. Add it here too.
!public/index.html
!public/pricing.html
!public/control.html
!public/contact.html
!public/privacy.html
!public/terms.html
!public/refunds.html
!public/recover.html
!public/docs.html
!public/license.html
!public/start.html
!public/favicon.ico
!public/favicon-32.png
!public/apple-touch-icon.png
